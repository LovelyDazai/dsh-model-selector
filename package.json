{
  "name": "dsh-model-menu-search",
  "version": "1.0.1",
  "description": "DSH WebUI 模型下拉菜单实时搜索框：给 composer 的模型选择菜单注入一个可打字过滤的搜索框（不抢座位、不改共享服务，跨版本可用）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "model",
    "search"
  ],
  "license": "MIT"
}
